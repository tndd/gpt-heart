PROJECT_URL=https://chatgpt.com/g/g-p-6a94c14fffb48191a369bb25418da7f7/project

# 初回のGoogleログイン中だけtrueにし、完了後はfalseへ戻します。
LOGIN_ONLY=false

# 空なら、noVNCで最初のメッセージを手動送信するまで待ちます。
INITIAL_BODY=

# Raspberry Piの負荷とChatGPTの利用上限を考慮し、最初は1を推奨します。
MAX_CONCURRENCY=1
ACTION_DELAY_MS=1500
COMPLETION_TIMEOUT_MS=1800000
POLL_INTERVAL_MS=1000
